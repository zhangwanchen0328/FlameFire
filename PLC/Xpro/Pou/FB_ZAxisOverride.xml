<?xml version='1.0' encoding='utf-8'?>
<pou xmlns="http://www.plcopen.org/xml/tc6_0201" xmlns:ns1="http://www.plcopen.org/xml/tc6_0201" xmlns:xhtml="http://www.w3.org/1999/xhtml" xmlns:xsd="http://www.w3.org/2001/XMLSchema" name="FB_ZAxisOverride" pouType="functionBlock">
  <interface>
    <externalVars>
      <variable name="g_ZOverride">
        <type>
          <derived name="MC_SETOVERRIDE"/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[进给倍率功能块]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="g_biZOverEnable">
        <type>
          <BOOL/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[进给倍率开始输入引脚]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="g_niZOverFactor">
        <type>
          <LREAL/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[进给倍率倍率输入引脚]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="g_boZOverDone">
        <type>
          <BOOL/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[进给倍率完成输出引脚]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="g_bPlcPauseBuffer">
        <type>
          <BOOL/>
        </type>
      </variable>
      <variable name="g_bPlcResetBuffer">
        <type>
          <BOOL/>
        </type>
      </variable>
      <variable name="g_bPlcStartBuffer">
        <type>
          <BOOL/>
        </type>
      </variable>
      <variable name="g_bLaserOnCorner">
        <type>
          <BOOL/>
        </type>
      </variable>
      <variable name="g_bZLiftingDone">
        <type>
          <BOOL/>
        </type>
      </variable>
      <variable name="g_bZFollowDone">
        <type>
          <BOOL/>
        </type>
      </variable>
      <variable name="g_bDryRunEnable">
        <type>
          <BOOL/>
        </type>
      </variable>
      <variable name="Axis_Z">
        <type>
          <derived name="AXIS_REF"/>
        </type>
      </variable>
    </externalVars>
    <localVars>
      <variable name="bOverEnable">
        <type>
          <BOOL/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[进给倍率开始]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="bOverDone">
        <type>
          <BOOL/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[进给倍率完成]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="nState">
        <type>
          <INT/>
        </type>
      </variable>
      <variable name="dOverFactor">
        <type>
          <LREAL/>
        </type>
        <initialValue>
          <simpleValue value="1.0"/>
        </initialValue>
        <documentation>
          <xhtml:p><![CDATA[进给倍率倍率]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="dCurOverride">
        <type>
          <LREAL/>
        </type>
      </variable>
      <variable name="dCornerFactor">
        <type>
          <LREAL/>
        </type>
      </variable>
      <variable name="RTrigger1">
        <type>
          <derived name="R_TRIG"/>
        </type>
      </variable>
      <variable name="RTrigger2">
        <type>
          <derived name="R_TRIG"/>
        </type>
      </variable>
      <variable name="FTrigger1">
        <type>
          <derived name="F_TRIG"/>
        </type>
      </variable>
    </localVars>
  </interface>
  <body>
    <ST>
      <xhtml:p><![CDATA[RTrigger1(CLK := g_bPlcStartBuffer);
RTrigger2(CLK := g_biZOverEnable OR bOverEnable);
FTrigger1(CLK := g_bLaserOnCorner);

IF RTrigger1.Q THEN (*如果暂停了，并且当前是在拐角，则对倍率进行处理*)
  IF g_bLaserOnCorner AND (NOT g_bDryRunEnable) AND (NOT g_bDebugMode) THEN
    nState := 5;
  END_IF;
END_IF;

IF RTrigger2.Q THEN
  IF g_biZOverEnable THEN
    dOverFactor := g_niZOverFactor;
    g_boZOverDone := TRUE;
  ELSIF bOverEnable THEN
    dOverFactor := dCurOverride;
    bOverDone := TRUE;
    bOverEnable := FALSE;
  END_IF;
END_IF;

IF FTrigger1.Q THEN
  dOverFactor := dCurOverride;  
  nState := 0;
END_IF;

CASE nState OF
  0:
    nState := 0;
  5:
    IF Axis_Z.NCTOPLC.AxisState = 9 THEN
      dOverFactor := dCornerFactor;
    ELSE
      dOverFactor := dCurOverride;
    END_IF;    
END_CASE;

g_ZOverride.Enable := TRUE;
g_ZOverride.VelFactor := dOverFactor;

IF g_bPlcResetBuffer THEN
  nState := 0;
  dOverFactor := dCurOverride;
END_IF;]]></xhtml:p>
    </ST>
  </body>
</pou>
