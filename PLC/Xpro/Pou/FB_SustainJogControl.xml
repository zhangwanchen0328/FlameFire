  <body>
    <ST>
      <xhtml:p><![CDATA[IF g_bFastInch THEN
  g_Sustain1Jog.Mode := 1;
  g_Sustain2Jog.Mode := 1;
  g_Sustain3Jog.Mode := 1;
  g_Sustain7Jog.Mode := 1;
  g_Sustain8Jog.Mode := 1;
  g_Sustain9Jog.Mode := 1;
ELSE
  g_Sustain1Jog.Mode := 0;
  g_Sustain2Jog.Mode := 0;
  g_Sustain3Jog.Mode := 0;
  g_Sustain7Jog.Mode := 0;
  g_Sustain8Jog.Mode := 0;
  g_Sustain9Jog.Mode := 0;
END_IF;

g_Sustain1Jog.JogForward := bJogForwardEnable1;
g_Sustain1Jog.JogBackwards := bJogBackwardEnable1;
g_boSustain1enable := g_Sustain1Jog.JogForward;
g_boSustain1errorid := g_Sustain1Jog.ERRORID;

g_Sustain2Jog.JogForward := bJogForwardEnable2;
g_Sustain2Jog.JogBackwards := bJogBackwardEnable2;
g_boSustain2enable := g_Sustain2Jog.JogForward;
g_boSustain2errorid := g_Sustain2Jog.ERRORID;

g_Sustain3Jog.JogForward := bJogForwardEnable3;
g_Sustain3Jog.JogBackwards := bJogBackwardEnable3;
g_boSustain3enable := g_Sustain3Jog.JogForward;
g_boSustain3errorid := g_Sustain3Jog.ERRORID;

g_Sustain7Jog.JogForward := bJogForwardEnable7;
g_Sustain7Jog.JogBackwards := bJogBackwardEnable7;
g_boSustain7enable := g_Sustain7Jog.JogForward;
g_boSustain7errorid := g_Sustain7Jog.ERRORID;

g_Sustain8Jog.JogForward := bJogForwardEnable8;
g_Sustain8Jog.JogBackwards := bJogBackwardEnable8;
g_boSustain8enable := g_Sustain8Jog.JogForward;
g_boSustain8errorid := g_Sustain8Jog.ERRORID;

g_Sustain9Jog.JogForward := bJogForwardEnable9;
g_Sustain9Jog.JogBackwards := bJogBackwardEnable9;
g_boSustain9enable := g_Sustain9Jog.JogForward;
g_boSustain9errorid := g_Sustain9Jog.ERRORID;

IF g_bPlcResetBuffer THEN
  bJogForwardEnable1 := FALSE;
  bJogBackwardEnable1 := FALSE;
  bJogForwardEnable2 := FALSE;
  bJogBackwardEnable2 := FALSE;
  bJogForwardEnable3 := FALSE;
  bJogBackwardEnable3 := FALSE;
  bJogForwardEnable7 := FALSE;
  bJogBackwardEnable7 := FALSE;
  bJogForwardEnable8 := FALSE;
  bJogBackwardEnable8 := FALSE;
  bJogForwardEnable9 := FALSE;
  bJogBackwardEnable9 := FALSE;
END_IF;]]></xhtml:p>
    </ST>
  </body>
