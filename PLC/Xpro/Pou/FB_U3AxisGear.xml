<?xml version='1.0' encoding='utf-8'?>
<pou xmlns="http://www.plcopen.org/xml/tc6_0201" xmlns:ns1="http://www.plcopen.org/xml/tc6_0201" xmlns:xhtml="http://www.w3.org/1999/xhtml" xmlns:xsd="http://www.w3.org/2001/XMLSchema" name="FB_U3AxisGear" pouType="functionBlock">
  <interface>
    <externalVars>
      <variable name="Axis_U3">
        <type>
          <derived name="AXIS_REF"/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[U轴轴结构体]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="g_biU3GearIn">
        <type>
          <BOOL/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[耦合开始输入引脚]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="g_biU3GearOut">
        <type>
          <BOOL/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[耦合关闭输入引脚]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="g_bU3GearIn">
        <type>
          <BOOL/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[耦合开始全局变量]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="g_bU3GearOut">
        <type>
          <BOOL/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[耦合关闭全局变量]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="g_boU3GearDone">
        <type>
          <BOOL/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[耦合完成引脚输出]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="g_bU3GearDone">
        <type>
          <BOOL/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[耦合完成全局变量]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="g_bU3GearError">
        <type>
          <BOOL/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[U轴耦合误差报警]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="g_bU3GearInError">
        <type>
          <BOOL/>
        </type>
      </variable>
      <variable name="g_bU3GearOutError">
        <type>
          <BOOL/>
        </type>
      </variable>
      <variable name="g_fiUCncCoord">
        <type>
          <LREAL/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[CNC中U轴坐标]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="g_U3GearIn">
        <type>
          <derived name="MC_GEARIN"/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[耦合模块]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="g_U3GearOut">
        <type>
          <derived name="MC_GEAROUT"/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[解耦模块]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="g_U3MoveStop">
        <type>
          <derived name="MC_STOP"/>
        </type>
      </variable>
      <variable name="g_noU3GearErrorID">
        <type>
          <USINT/>
        </type>
      </variable>
    </externalVars>
    <localVars>
      <variable name="nGearState">
        <type>
          <INT/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[状态机]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="nRatioNumerator">
        <type>
          <INT/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[比例分子]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="nRatioDenominator">
        <type>
          <USINT/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[比例分母]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="dCoordDiff">
        <type>
          <LREAL/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[耦合成功时U和U2的坐标差]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="dCoordMaxDiff">
        <type>
          <LREAL/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[U和U2最大的的坐标差]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="bGearIn">
        <type>
          <BOOL/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[耦合开始]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="bGearOut">
        <type>
          <BOOL/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[耦合关闭]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="bGearDone">
        <type>
          <BOOL/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[耦合完成]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="bGearCheck">
        <type>
          <BOOL/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[是否检测耦合误差]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="RTrigger1">
        <type>
          <derived name="R_TRIG"/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[上升沿函数]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="RTrigger2">
        <type>
          <derived name="R_TRIG"/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[下降沿函数]]></xhtml:p>
        </documentation>
      </variable>
    </localVars>
  </interface>
  <body>
    <ST>
      <xhtml:p><![CDATA[
RTrigger1(CLK := g_biU3GearIn OR g_bU3GearIn OR bGearIn);
RTrigger2(CLK := g_biU3GearOut OR g_bU3GearOut OR bGearOut);

IF RTrigger1.Q THEN
  IF Axis_U3.NCTOPLC.AxisState <> 8 THEN
    nGearState := 1;
    g_boU3GearDone := FALSE;
    g_bU3GearDone := FALSE;
    bGearDone := FALSE;
  END_IF;
END_IF;

IF RTrigger2.Q THEN
  IF Axis_U3.NCTOPLC.AxisState = 8 THEN
    nGearState := 2;
    g_boU3GearDone := FALSE;
    g_bU3GearDone := FALSE;
    bGearDone := FALSE;
  END_IF;
END_IF;

CASE nGearState OF
  0:
    nGearState := 0;
  1:
    g_U3GearIn.Execute := TRUE;
    g_U3GearIn.RatioNumerator := INT_TO_LREAL(nRatioNumerator);
    g_U3GearIn.RatioDenominator := nRatioDenominator;
    IF g_U3GearIn.InGear THEN
      g_boU3GearDone := TRUE;
      g_bU3GearDone := TRUE;
      bGearDone := TRUE;
      nGearState := 30;
      bGearCheck := TRUE;
      dCoordDiff := ABS(g_fiUCncCoord - Axis_U3.NCTOPLC.ACTPOS);
    END_IF;
    IF g_U3GearIn.Error OR g_U3GearIn.CommandAborted THEN
      g_U3GearIn.Execute := FALSE;
      g_noU3GearErrorID := g_U3GearIn.ErrorID;
      g_bU3GearInError := TRUE;
      nGearState := 0;
    END_IF;
  2:
    g_U3GearOut.Execute := TRUE;
    g_U3GearIn.Execute := FALSE;
    IF g_U3GearOut.Done THEN
      g_U3GearOut.Execute := FALSE;
      IF Axis_U3.NCTOPLC.AxisState = 2 THEN
        nGearState := 0;
      ELSE
        nGearState := 3;
      END_IF;
    END_IF;
    IF g_U3GearOut.Error THEN
      g_U3GearOut.Execute := FALSE;
      g_bU3GearInError := TRUE;
      nGearState := 0;
      bGearCheck := FALSE;
    END_IF;
  3:
    g_U3MoveStop.Execute := TRUE;
    IF g_U3MoveStop.Done THEN
      g_U3MoveStop.Execute := FALSE;
      nGearState := 0;
    END_IF;
    IF g_U3MoveStop.Commandaborted OR g_U3MoveStop.Error THEN
      g_U3MoveStop.Execute := FALSE;
      nGearState := 0;
    END_IF;
  30:
    IF Axis_U3.NCTOPLC.AxisState = 8 THEN

      IF ABS(ABS(g_fiUCncCoord - Axis_U3.NCTOPLC.ACTPOS) - dCoordDiff) > dCoordMaxDiff AND Axis_U3.NCTOPLC.AXISSTATE = 8 THEN

          g_bU3GearError := TRUE;

      END_IF;

    END_IF;
END_CASE;


]]></xhtml:p>
    </ST>
  </body>
</pou>
