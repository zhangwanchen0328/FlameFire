  <body>
    <ST>
      <xhtml:p><![CDATA[(*默认为10个驱动器，监控它们的错误id,扭力值，速度反馈值*)
CASE g_nDriverBrand OF
  0:
    FOR nAxisNumber := 0 TO 9 BY 1 DO
       CASE nAxisNumber OF
        0:
           g_nServoError0   := g_niDriverError0;
           g_fServoTorque0  := g_fiDriverTorque0;
           g_fServoVelcity0 := g_fiDriverVelcity0;
        1:
           g_nServoError1   := g_niDriverError1;
           g_fServoTorque1  := g_fiDriverTorque1;
           g_fServoVelcity1 := g_fiDriverVelcity1;
        2:
           g_nServoError2   := g_niDriverError2;
           g_fServoTorque2  := g_fiDriverTorque2;
           g_fServoVelcity2 := g_fiDriverVelcity2;
        3:
           g_nServoError3   := g_niDriverError3;
           g_fServoTorque3  := g_fiDriverTorque3;
           g_fServoVelcity3 := g_fiDriverVelcity3;
        4:
           g_nServoError4   := g_niDriverError4;
           g_fServoTorque4  := g_fiDriverTorque4;
           g_fServoVelcity5 := g_fiDriverVelcity4;
        5:
           g_nServoError5   := g_niDriverError5;
           g_fServoTorque5  := g_fiDriverTorque5;
           g_fServoVelcity5 := g_fiDriverVelcity5;
        6:
           g_nServoError6   := g_niDriverError6;
           g_fServoTorque6  := g_fiDriverTorque6;
           g_fServoVelcity6 := g_fiDriverVelcity6;
        7:
           g_nServoError7   := g_niDriverError7;
           g_fServoTorque7  := g_fiDriverTorque7;
           g_fServoVelcity7 := g_fiDriverVelcity7;
        8:
           g_nServoError8   := g_niDriverError8;
           g_fServoTorque8  := g_fiDriverTorque8;
           g_fServoVelcity8 := g_fiDriverVelcity8;
        9:
           g_nServoError9   := g_niDriverError9;
           g_fServoTorque9  := g_fiDriverTorque9;
           g_fServoVelcity9 := g_fiDriverVelcity9;
      END_CASE;
    END_FOR;
END_CASE;




]]></xhtml:p>
