    <externalVars>
      <variable name="g_bFastInch">
        <type>
          <BOOL/>
        </type>
      </variable>
    </externalVars>
    <localVars>
      <variable name="dY2AxisSlowVel">
        <type>
          <LREAL/>
        </type>
      </variable>
      <variable name="dY3AxisSlowVel">
        <type>
          <LREAL/>
        </type>
      </variable>
      <variable name="dY2AxisFastVel">
        <type>
          <LREAL/>
        </type>
      </variable>
      <variable name="dY3AxisFastVel">
        <type>
          <LREAL/>
        </type>
      </variable>
    </localVars>
  </interface>
  <body>
    <ST>
      <xhtml:p><![CDATA[RY3Trigger(CLK := g_biY3RelExecute OR bY3RelEXecute OR g_bY3RelExecute);

IF RY3Trigger.Q THEN
  nY3RelState := 1;
  g_boY3RelDone := FALSE;
  g_bY3RelDone := FALSE;
  bY3RelDone := FALSE;
  IF g_biY3RelExecute THEN
    dY3TargetPos := Axis_Y3.NCTOPLC.ActPos + g_fiY3RelDistance; 
    dY3TargetVel := g_fiY3RelVelocity;
  ELSIF g_bY3RelExecute THEN
    dY3TargetPos := Axis_Y3.NCTOPLC.ActPos + g_fY3RelDistance; 
    dY3TargetVel := g_fY3RelVelocity;
  ELSE
    dY3TargetPos := Axis_Y3.NCTOPLC.ActPos + dY3RelDistance; 
    IF g_bFastInch=0 THEN
      dY3TargetVel := dY3AxisSlowVel;
    ELSE
      dY3TargetVel := dY3AxisFastVel;
    END_IF;
  END_IF;
  IF dY3TargetVel = 0.0 THEN
    dY3TargetVel := dY3RelVelocity;
  END_IF;
END_IF;

IF NOT(g_biY3RelExecute OR bY3RelEXecute OR g_bY3RelExecute) THEN
  g_boY3RelDone := FALSE;
  g_bY3RelDone := FALSE;
  bY3RelDone := FALSE;
END_IF;

CASE nY3RelState OF
  0:
    nY3RelState := 0;
  1:
    g_Y3MoveRel.Execute := TRUE;
    g_Y3MoveRel.Velocity := dY3TargetVel;
    g_Y3MoveRel.Distance := dY3TargetPos - Axis_Y3.NCTOPLC.ActPos;
    IF g_Y3MoveRel.Done THEN
      g_Y3MoveRel.Execute := FALSE;
      g_boY3RelDone := TRUE;
      g_bY3RelDone := TRUE;
      bY3RelDone := TRUE;
      nY3RelState := 0;
    END_IF;
    IF g_bPlcPauseBuffer THEN
      nY3RelState := 20;
    END_IF;
    IF g_Y3MoveRel.CommandAborted OR g_Y3MoveRel.Error THEN
      g_Y3MoveRel.Execute := FALSE;
      nY3RelState := 0;
    END_IF;
  20:
    g_Y3MoveRel.Execute := FALSE;
    g_Y3MoveStop.Execute := TRUE;
    IF g_Y3MoveStop.Done AND g_bPlcStartBuffer THEN
      g_Y3MoveStop.Execute := FALSE;
      nY3RelState := 1;
    END_IF;
    IF g_Y3MoveStop.CommandAborted OR g_Y3MoveStop.Error THEN
      g_Y3MoveStop.Execute := FALSE;
      nY3RelState := 0;
    END_IF;
END_CASE;


RY2Trigger(CLK := g_biY2RelExecute OR bY2RelEXecute OR g_bY2RelExecute);

IF RY2Trigger.Q THEN
  nY2RelState := 1;
  g_boY2RelDone := FALSE;
  g_bY2RelDone := FALSE;
  bY2RelDone := FALSE;
  IF g_biY2RelExecute THEN
    dY2TargetPos := Axis_Y2.NCTOPLC.ActPos + g_fiY2RelDistance; 
    dY2TargetVel := g_fiY2RelVelocity;
  ELSIF g_bY2RelExecute THEN
    dY2TargetPos := Axis_Y2.NCTOPLC.ActPos + g_fY2RelDistance; 
    dY2TargetVel := g_fY2RelVelocity;
  ELSE
    dY2TargetPos := Axis_Y2.NCTOPLC.ActPos + dY2RelDistance; 
    IF g_bFastInch=0 THEN
      dY2TargetVel := dY2AxisSlowVel;
    ELSE
      dY2TargetVel := dY2AxisFastVel;
    END_IF;
  END_IF;
  IF dY2TargetVel = 0.0 THEN
    dY2TargetVel := dY2RelVelocity;
  END_IF;
END_IF;

IF NOT(g_biY2RelExecute OR bY2RelEXecute OR g_bY2RelExecute) THEN
  g_boY2RelDone := FALSE;
  g_bY2RelDone := FALSE;
  bY2RelDone := FALSE;
END_IF;

CASE nY2RelState OF
  0:
    nY2RelState := 0;
  1:
    g_Y2MoveRel.Execute := TRUE;
    g_Y2MoveRel.Velocity := dY2TargetVel;
    g_Y2MoveRel.Distance := dY2TargetPos - Axis_Y2.NCTOPLC.ActPos;
    IF g_Y2MoveRel.Done THEN
      g_Y2MoveRel.Execute := FALSE;
      g_boY2RelDone := TRUE;
      g_bY2RelDone := TRUE;
      bY2RelDone := TRUE;
      nY2RelState := 0;
    END_IF;
    IF g_bPlcPauseBuffer THEN
      nY2RelState := 20;
    END_IF;
    IF g_Y2MoveRel.CommandAborted OR g_Y2MoveRel.Error THEN
      g_Y2MoveRel.Execute := FALSE;
      nY2RelState := 0;
    END_IF;
  20:
    g_Y2MoveRel.Execute := FALSE;
    g_Y2MoveStop.Execute := TRUE;
    IF g_Y2MoveStop.Done AND g_bPlcStartBuffer THEN
      g_Y2MoveStop.Execute := FALSE;
      nY2RelState := 1;
    END_IF;
    IF g_Y2MoveStop.CommandAborted OR g_Y2MoveStop.Error THEN
      g_Y2MoveStop.Execute := FALSE;
      nY2RelState := 0;
    END_IF;
END_CASE;

IF g_bPlcResetBuffer THEN
  nY2RelState := 0;
  g_Y2MoveRel.Execute := FALSE;
  g_Y2MoveStop.Execute := FALSE;
  
  nY3RelState := 0;
  g_Y3MoveRel.Execute := FALSE;
  g_Y3MoveStop.Execute := FALSE;
END_IF;]]></xhtml:p>
    </ST>
  </body>
  <documentation>
    <xhtml:p><![CDATA[Y2Y3相对运动]]></xhtml:p>
  </documentation>
</pou>
