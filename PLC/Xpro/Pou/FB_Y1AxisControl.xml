<?xml version='1.0' encoding='utf-8'?>
<pou xmlns="http://www.plcopen.org/xml/tc6_0201" xmlns:ns1="http://www.plcopen.org/xml/tc6_0201" xmlns:xhtml="http://www.w3.org/1999/xhtml" xmlns:xsd="http://www.w3.org/2001/XMLSchema" name="FB_Y1AxisControl" pouType="functionBlock">
  <interface>
    <localVars>
      <variable name="FBY1AxisPower">
        <type>
          <derived name="FB_Y1AxisPower"/>
        </type>
      </variable>
      <variable name="FBY1AxisHome">
        <type>
          <derived name="FB_Y1AxisHome"/>
        </type>
      </variable>
      <variable name="FBY1AxisJog">
        <type>
          <derived name="FB_Y1AxisJog"/>
        </type>
      </variable>
      <variable name="FBY1AxisRel">
        <type>
          <derived name="FB_Y1AxisRel"/>
        </type>
      </variable>
      <variable name="FBY1AxisAbs">
        <type>
          <derived name="FB_Y1AxisAbs"/>
        </type>
      </variable>
      <variable name="FBY1ActMoveMotion">
        <type>
          <derived name="FB_Y1ActMoveMotion"/>
        </type>
      </variable>
      <variable name="FBY1AxisGear">
        <type>
          <derived name="FB_Y1AxisGear"/>
        </type>
      </variable>
    </localVars>
    <externalVars>
      <variable name="g_Y1Reset">
        <type>
          <derived name="MC_RESET"/>
        </type>
      </variable>
      <variable name="g_bPlcResetBuffer">
        <type>
          <BOOL/>
        </type>
      </variable>
      <variable name="Axis_Y1">
        <type>
          <derived name="AXIS_REF"/>
        </type>
      </variable>
    </externalVars>
  </interface>
  <body>
    <ST>
      <xhtml:p><![CDATA[FBY1AxisPower();
FBY1AxisHome();
FBY1AxisJog();
FBY1AxisRel();
FBY1AxisAbs();
FBY1ActMoveMotion();
FBY1AxisGear();
IF Axis_Y1.NCTOPLC.AxisState = 8 THEN
  g_Y1Reset.Execute := FALSE;
ELSE
  g_Y1Reset.Execute := g_bPlcResetBuffer;
END_IF;]]></xhtml:p>
    </ST>
  </body>
</pou>
