        <type>
          <LREAL/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[减去管材后的空隙长度]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="dVoidFeedingVelocity">
        <type>
          <LREAL/>
        </type>
