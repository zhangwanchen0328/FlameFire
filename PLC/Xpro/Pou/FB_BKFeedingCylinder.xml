    </localVars>
    <externalVars>
      <variable name="g_bPlcResetBuffer">
        <type>
          <BOOL/>
        </type>
      </variable>
    </externalVars>
    <localVars>
      <variable name="Ton_FeedCylinderDelay">
        <type>
          <derived name="TON"/>
        </type>
      </variable>
      <variable name="FeedCylinderDelay">
        <type>
          <LREAL/>
        </type>
      </variable>
      <variable name="Ton_Trigger3">
        <type>
          <derived name="TON"/>
        </type>
      </variable>
      <variable name="bTrigger3">
        <type>
          <BOOL/>
        </type>
      </variable>
      <variable name="bTroughSignal">
        <type>
          <BOOL/>
        </type>
      </variable>
      <variable name="dTroughSignalTime">
        <type>
          <LREAL/>
        </type>
      </variable>
    </localVars>
    <externalVars>
      <variable name="g_nBKFeedingState">
        <type>
          <INT/>
        </type>
      </variable>
      <variable name="g_bPressurePipeSignal">
        <type>
          <BOOL/>
        </type>
      </variable>
      <variable name="g_boFeedingSensorLimit">
        <type>
          <BOOL/>
        </type>
      </variable>
    </externalVars>
  </interface>
  <body>
    <ST>
      <xhtml:p><![CDATA[R_Trriger1(CLK := g_biFeedingCylinderOpen);
R_Trriger2(CLK := g_biFeedingCylinderClose);

IF R_Trriger1.Q THEN
  g_boFeedingCylinderDone1 := FALSE;
  g_boFeedingCylinderDone2 := FALSE;
  nSwitchState := 1;
END_IF;

IF R_Trriger2.Q THEN
  g_boFeedingCylinderDone1 := FALSE;
  g_boFeedingCylinderDone2 := FALSE;
END_IF;

(*IF g_biFeedTroughSignal THEN
  Ton_Trigger3(IN := TRUE,PT := LREAL_TO_TIME(dTroughSignalTime/1000.0));
  IF Ton_Trigger3.Q THEN
    bTrigger3 := FALSE;
    bTroughSignal := TRUE;
    Ton_Trigger3(IN := FALSE);
  END_IF;
ELSE 
  Ton_Trigger3(IN := FALSE);
  bTroughSignal := FALSE;
END_IF;*)

IF Feeding_Axis.NCTOPLC.ACTPOS >= dCylinderPos1 - dSafeDistance1 THEN
  g_boCylinderY2 := FALSE;
END_IF;
IF Feeding_Axis.NCTOPLC.ACTPOS >= dCylinderPos2 - dSafeDistance2 THEN
  g_boCylinderY3 := FALSE;
END_IF;

CASE nSwitchState OF
  0:
  nSwitchState := 0;
  1:
  IF g_bPressurePipeSignal THEN
    IF Feeding_Axis.NCTOPLC.ACTPOS <= dCylinderPos1 - dSafeDistance1 THEN
      g_boCylinderY2 := TRUE;
    END_IF;
    IF Feeding_Axis.NCTOPLC.ACTPOS <= dCylinderPos2 - dSafeDistance2 THEN
      g_boCylinderY3 := TRUE;
    END_IF;
    Ton_Delay(IN := TRUE,PT := LREAL_TO_TIME(dCylinderDownTime/1000.0));
    IF Ton_Delay.Q THEN
      Ton_Delay(IN := FALSE);
      nSwitchState := 2;
    END_IF;
  END_IF;
  2:
  g_boFeedingCylinderDone1 := TRUE;
  g_boFeedingSensorLimit := FALSE;
  g_nBKFeedingState := 5;
  nSwitchState := 0;
END_CASE;

IF g_bPlcResetBuffer THEN
  g_boCylinderY2 := FALSE;
  g_boCylinderY3 := FALSE;
  (*bTroughSignal := FALSE;*)
  nSwitchState := 0;
END_IF;]]></xhtml:p>
    </ST>
  </body>
</pou>
