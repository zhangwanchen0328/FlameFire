        <type>
          <BOOL/>
        </type>
      </variable>
      <variable name="g_boFeedingCylinderDone2">
        <type>
          <BOOL/>
        </type>
      </variable>
      <variable name="g_boCylinderY2">
        <type>
          <BOOL/>
        </type>
      </variable>
      <variable name="g_boCylinderY3">
        <type>
          <BOOL/>
        </type>
      </variable>
      <variable name="g_biFeedTroughSignal">
        <type>
          <BOOL/>
        </type>
      </variable>
      <variable name="g_biDischargeRack1">
