          <BOOL/>
        </type>
      </variable>
      <variable name="g_boMaterialCylinder">
        <type>
          <BOOL/>
        </type>
      </variable>
      <variable name="g_biProCylinderUp">
        <type>
          <BOOL/>
        </type>
      </variable>
      <variable name="g_Alarm">
        <type>
          <derived name="DT_ALARM"/>
        </type>
      </variable>
      <variable name="FeedingAbs">
        <type>
          <derived name="MC_MOVEABSOLUTE"/>
        </type>
      </variable>
    </externalVars>
    <localVars>
      <variable name="dDistance">
        <type>
          <LREAL/>
        </type>
      </variable>
      <variable name="dVelocity">
        <type>
          <LREAL/>
        </type>
      </variable>
      <variable name="R_Trriger1">
        <type>
          <derived name="R_TRIG"/>
        </type>
      </variable>
      <variable name="R_Trriger2">
        <type>
          <derived name="R_TRIG"/>
        </type>
      </variable>
      <variable name="nSwitchState">
        <type>
          <INT/>
        </type>
      </variable>
      <variable name="Ton_Delay">
        <type>
          <derived name="TON"/>
        </type>
      </variable>
      <variable name="FeedingCylinder_Delay">
        <type>
          <derived name="TON"/>
        </type>
      </variable>
      <variable name="dCylinderDownTime">
        <type>
          <LREAL/>
        </type>
      </variable>
      <variable name="dFeedingCylinderTime">
        <type>
          <LREAL/>
        </type>
      </variable>
      <variable name="dSafeDistance1">
        <type>
          <LREAL/>
        </type>
      </variable>
      <variable name="dSafeDistance2">
        <type>
          <LREAL/>
        </type>
      </variable>
      <variable name="dCylinderPos1">
        <type>
          <LREAL/>
        </type>
      </variable>
      <variable name="dCylinderPos2">
        <type>
          <LREAL/>
        </type>
      </variable>
