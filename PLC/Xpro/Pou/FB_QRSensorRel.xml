<?xml version='1.0' encoding='utf-8'?>
<pou xmlns="http://www.plcopen.org/xml/tc6_0201" xmlns:ns1="http://www.plcopen.org/xml/tc6_0201" xmlns:xhtml="http://www.w3.org/1999/xhtml" xmlns:xsd="http://www.w3.org/2001/XMLSchema" name="FB_QRSensorRel" pouType="functionBlock">
  <interface>
    <externalVars>
      <variable name="g_bPlcStartBuffer">
        <type>
          <BOOL/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[Plc开始]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="g_bPlcPauseBuffer">
        <type>
          <BOOL/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[Plc暂停]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="g_bPlcResetBuffer">
        <type>
          <BOOL/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[Plc复位]]></xhtml:p>
        </documentation>
      </variable>
    </externalVars>
    <localVars>
      <variable name="bSensorAbsOpen">
        <type>
          <BOOL/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[绝对运动开始引脚输入]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="bSensorAbsClose">
        <type>
          <BOOL/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[绝对运动开始引脚输入]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="bSensorAbsDone">
        <type>
          <BOOL/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[绝对运动完成引脚输出]]></xhtml:p>
        </documentation>
      </variable>
    </localVars>
    <externalVars>
      <variable name="g_SensorAbs">
        <type>
          <derived name="MC_MOVEABSOLUTE"/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[绝对运动模块]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="g_SensorStop">
        <type>
          <derived name="MC_STOP"/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[停止运动模块]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="g_SensorReset">
        <type>
          <derived name="MC_RESET"/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[复位运动模块]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="Axis_Sensor">
        <type>
          <derived name="AXIS_REF"/>
        </type>
      </variable>
    </externalVars>
    <localVars>
      <variable name="nSensorRelState">
        <type>
          <INT/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[绝对运动状态机]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="dTargetVel">
        <type>
          <LREAL/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[绝对运动目标速度]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="RTrigger1">
        <type>
          <derived name="R_TRIG"/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[上升沿函数]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="RTrigger2">
        <type>
          <derived name="R_TRIG"/>
        </type>
      </variable>
      <variable name="dDistance">
        <type>
          <LREAL/>
        </type>
      </variable>
    </localVars>
    <externalVars>
      <variable name="g_bFastInch">
        <type>
          <BOOL/>
        </type>
      </variable>
    </externalVars>
    <localVars>
      <variable name="dSensorAxisSlowVel">
        <type>
          <LREAL/>
        </type>
      </variable>
      <variable name="dSensorAxisFastVel">
        <type>
          <LREAL/>
        </type>
      </variable>
    </localVars>
  </interface>
  <body>
    <ST>
      <xhtml:p><![CDATA[RTrigger1(CLK := bSensorAbsOpen);
RTrigger2(CLK := bSensorAbsClose);

IF RTrigger1.Q THEN
  nSensorRelState := 1;
  bSensorAbsDone := FALSE;
END_IF;
IF RTrigger2.Q THEN
  bSensorAbsDone := FALSE;
END_IF;

CASE nSensorRelState OF
  0:
    nSensorRelState := 0;
  1:
    g_SensorAbs.Execute := TRUE;
    IF g_bFastInch=0 THEN
      g_SensorAbs.Velocity := dSensorAxisSlowVel;
    ELSE
      g_SensorAbs.Velocity := dSensorAxisFastVel;
    END_IF;
    g_SensorAbs.Position := Axis_Sensor.NCTOPLC.SETPOS + dDistance;
    IF g_SensorAbs.Done THEN
      g_SensorAbs.Execute := FALSE;
      bSensorAbsDone := TRUE;
      nSensorRelState := 0;
    END_IF;
    IF g_bPlcPauseBuffer THEN
      nSensorRelState := 20;
    END_IF;
    IF g_SensorAbs.CommandAborted OR g_SensorAbs.Error THEN
      g_SensorAbs.Execute := FALSE;
      bSensorAbsDone := FALSE;
      nSensorRelState := 0;
    END_IF;
  20:
    g_SensorAbs.Execute := FALSE;
    g_SensorStop.Execute := TRUE;
    IF g_SensorStop.Done AND g_bPlcStartBuffer THEN
      g_SensorStop.Execute := FALSE;
      nSensorRelState := 1;
    END_IF;
    IF g_SensorStop.CommandAborted OR g_SensorStop.Error THEN
      g_SensorStop.Execute := FALSE;
      nSensorRelState := 0;
    END_IF;
END_CASE;

IF g_bPlcResetBuffer THEN
  nSensorRelState := 0;
  g_SensorAbs.Execute := FALSE;
  g_SensorStop.Execute := FALSE;
END_IF;]]></xhtml:p>
    </ST>
  </body>
</pou>
