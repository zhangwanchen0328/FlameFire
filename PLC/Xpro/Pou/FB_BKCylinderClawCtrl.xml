  <body>
    <ST>
      <xhtml:p><![CDATA[R_Trriger1(CLK := bFeedingCylinderUp);
R_Trriger2(CLK := bPressurePipeCy1Up);
R_Trriger3(CLK := bPressurePipeCy2Up);
R_Trriger4(CLK := bClawEnableClamp);
R_Trriger5(CLK := bDustCylinderUp);
R_Trriger6(CLK := bFeedingCylinderDown);
R_Trriger7(CLK := bPressurePipeCy1Down);
R_Trriger8(CLK := bPressurePipeCy2Down);
R_Trriger9(CLK := bClawEnableLoosen);
R_Trriger10(CLK := bDustCylinderDown);
R_Trriger11(CLK := bMaterialCylinderUp);
R_Trriger12(CLK := bMaterialCylinderDown);
R_Trriger13(CLK := bRackForwardOn);
R_Trriger14(CLK := bRackForwardOff);
R_Trriger15(CLK := bRackBackwardsOn);
R_Trriger16(CLK := bRackBackwardsOff);
R_Trriger17(CLK := bVacuumDustValveOn);
R_Trriger18(CLK := bVacuumDustValveOff);
R_Trriger19(CLK := bDosingCylinderUp);
R_Trriger20(CLK := bDosingCylinderDown);

IF R_Trriger1.Q THEN
  g_boMaterialCylinder := TRUE;
END_IF;

IF R_Trriger6.Q THEN
  g_boMaterialCylinder := FALSE;
END_IF;

IF R_Trriger2.Q THEN
  g_boCylinderY2 := TRUE;
END_IF;

IF R_Trriger7.Q THEN
  g_boCylinderY2 := FALSE;
END_IF;

IF R_Trriger3.Q THEN
  g_boCylinderY3 := TRUE;
END_IF;

IF R_Trriger8.Q THEN
  g_boCylinderY3 := FALSE;
END_IF;

IF R_Trriger4.Q THEN
  g_boClawState := TRUE;
END_IF;

IF R_Trriger9.Q THEN
  g_boClawState := FALSE;
END_IF;

IF R_Trriger5.Q THEN
  g_boDustCylinder := TRUE;
END_IF;

IF R_Trriger10.Q THEN
  g_boDustCylinder := FALSE;
END_IF;
(*托料气缸*)
IF R_Trriger11.Q THEN
  g_boFixedLenSupportCyl := TRUE;
END_IF;

IF R_Trriger12.Q THEN
  g_boFixedLenSupportCyl := FALSE;
END_IF;
(*上料正反转*)
IF R_Trriger13.Q THEN
  g_boForward := TRUE;
END_IF;

IF R_Trriger14.Q THEN
  g_boForward := FALSE;
END_IF;

IF R_Trriger15.Q THEN
  g_boBackward := TRUE;
END_IF;

IF R_Trriger16.Q THEN
  g_boBackward := FALSE;
END_IF;

(*送料平台上升下降*)
IF bPlatformUp THEN
  g_boPlatformUp := TRUE;
ELSE
  g_boPlatformUp := FALSE;
END_IF;

IF bPlatformDown THEN
  g_boPlatformDown := TRUE;
ELSE
  g_boPlatformDown := FALSE;
END_IF;

IF R_Trriger17.Q THEN
  g_boDustVacuum := TRUE;
END_IF;

IF R_Trriger18.Q THEN
  g_boDustVacuum := FALSE;
END_IF;

IF R_Trriger19.Q THEN
  g_boDosingCylinder := TRUE;
END_IF;

IF R_Trriger20.Q THEN
  g_boDosingCylinder := FALSE;
END_IF;

IF g_bPlcResetBuffer THEN
  g_boClawState := FALSE;
  g_boDustCylinder := FALSE;
  g_boCylinderY3 := FALSE;
  g_boCylinderY2 := FALSE;
  g_boMaterialCylinder := FALSE;
  g_boFixedLenSupportCyl := FALSE;
  g_boForward := FALSE;
  g_boBackward := FALSE;
  g_boPlatformUp := FALSE;
  g_boPlatformDown := FALSE;
  g_boDustVacuum := FALSE;
  g_boDosingCylinder := FALSE;
END_IF;]]></xhtml:p>
    </ST>
  </body>
</pou>
