        </type>
      </variable>
    </localVars>
    <externalVars>
      <variable name="g_boCylinderY2">
        <type>
          <BOOL/>
        </type>
      </variable>
      <variable name="g_boCylinderY3">
        <type>
          <BOOL/>
        </type>
      </variable>
      <variable name="g_boClawState">
        <type>
          <BOOL/>
        </type>
      </variable>
      <variable name="g_boMaterialCylinder">
        <type>
          <BOOL/>
        </type>
      </variable>
      <variable name="g_boDustCylinder">
        <type>
          <BOOL/>
        </type>
      </variable>
      <variable name="g_bPlcResetBuffer">
        <type>
          <BOOL/>
        </type>
      </variable>
      <variable name="g_boForward">
        <type>
          <BOOL/>
        </type>
      </variable>
      <variable name="g_boBackward">
        <type>
          <BOOL/>
        </type>
      </variable>
      <variable name="g_boFixedLenSupportCyl">
        <type>
          <BOOL/>
        </type>
      </variable>
      <variable name="g_boPlatformUp">
        <type>
          <BOOL/>
        </type>
      </variable>
      <variable name="g_boPlatformDown">
