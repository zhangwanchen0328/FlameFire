  <body>
    <ST>
      <xhtml:p><![CDATA[IF g_bPlcPause THEN
  g_bPlcPauseBuffer := TRUE;
END_IF;
IF g_bPlcStart THEN
  g_bPlcStartBuffer := TRUE;
END_IF;
IF g_bPlcReset  THEN
  g_bPlcResetBuffer := TRUE;
  g_bChangeSecondFlyAndPowerCutCommunicationCycle := FALSE;
END_IF;
IF g_bplcHardwareReset THEN   (*plc伺服复位*)
  g_bplcHardwareResetBuffer := TRUE;
  g_bChangeSecondFlyAndPowerCutCommunicationCycle := FALSE;
END_IF;
IF g_bClearAlarmButtonClicked THEN
  g_bClearAlarmButtonClickedBuffer := TRUE;
END_IF;
(*如果配置了配置了中卡避让进给轴就默认把Y轴坐标判断和中卡避让进给轴绑定*)
IF g_bIsConfigMiddleAvoidAxis1 THEN
  g_fCurrentCoordYBuffer := AntiRejection4.NCTOPLC.ACTPOS;
ELSE
  g_fCurrentCoordYBuffer := g_fiCurrentCoordY;
END_IF;
g_bIsSetSlowCutEnableFlag := FALSE;
g_noMachineType :=g_nMachineType;
FBinit();
FBNCAxisDataSet();
(*FBinputControl();
FBoutputControl();*)
FBhomeSignalCheck();      (*回零信号判断*)
FBhardSignalHandle();     (*各种硬件信号常开常闭判断*)
FBcommunicationCheck();   (*从站OP状态判断*)
FBemergencyStop();        (*急停信号触发安全操作*)
FBalarmHandle();          (*各种报警，写到数组里面*)  
FBstatusUpdate();         (*根据M代码和全局变量更新PLC状态*)
FBservoControl();         (*CNC轴使能控制*)
FBautoParalle();          (*自动对边*)
FBcalibrateLevel();       (*校水平*)
FBconcentricity();        (*四面分中*)
FBProcessHalCloseLaser(); (*切割关光*)
FBProcessHalCloseFollow();(*切割关随动*)
FBprocessControl();     (*随动切割*)
 FBProcessCoordCut();    (*坐标切割*)
IF g_fCuttingType=1 THEN
	FBZCoordCutVelAdd();
END_IF;

FBZAxisControl();         (*Z轴控制*)
IF g_bU2AxisEnable THEN
  FBUAxisControl();         (*U2轴控制*)
END_IF;
FBFAxisMotionControl(); (*F轴控制*)
IF g_nFAxisControlType = 3 THEN (*如果是普雷的切割头。则将普雷调焦的使能变量给外部唯一的调焦使能引脚*)
  g_boVoltageEnable := g_boPresterFoucsEnable;
END_IF;
FBauxiliaryControl();     (*支撑气缸、卡爪逻辑控制*)
FBGasListen();
FBFlameGasListen();
FBlaserControl();         (*激光出光控制，包括打点、红光、上电等*)
FBuserDefinedAlarm();     (*自定义报警*)
FBautoLubrication();      (*自动润滑*)
FBtricolorLight();        (*三个灯输出控制*)
FBuserDefinedIOOutput();  (*自定义IO*)
FBIOMonitor();            (*IO监控*)
FBservoMonitor();         (*驱动器状态监控*)
FBclearNCAlarm();         (*清除报警*)
FBCircleCenter();         (*圆管校横梁中心*)
FBbeamCenter();           (*方管校横梁中心*)
FBHMICompensationCalc();   (*HMI执行分中补偿值计算*)




FBactual_Xposition();     (*计算拐角电容模型X位置*)
FBCornerLaserExportCtrl();(*进出拐角关光延时*)
FBDiscernHighLowSurface();(*区分矩形管的高低面*)
FBFourSideUpLiftHeight(); (*四面分中Z轴上抬*)
FBTwoSideCenterAngleIron();(*角钢两面分中*)
FBSingleSideCenter(); (*单面分中*)
FBFourSidesCenter();(*四面寻中*)
FBTwoSidesCenter();(*两面寻中*)
FBThreeSidesCenter();(*三面寻中*)
(********新框架FB start**************)
(*轴、工艺数据下发及上传，M代码控制*)
FBUpLoadStatusToHmi();(*Plc数据上传到Hmi*)
FB_DownloadTechDataFromHMI();(*把工艺参数传给HMI*)

FBCncMControl();(*M代码*)
FBGlobalValueOutPut();(*全局变量输出*)
FBCenterNear();(*就近回中*)
FBLevelAndSideCenter();(*校平+分中*)
FBrealTimeOverrid();(*角钢进给降速*)
FBSplitValue();
FBUserDefineListen();

FBParalleGetZMaxPos();(*寻边时 获取z轴最大坐标*)
(********新框架FB end**************)
IF g_nLoadMaterialNum <> 0 THEN
  FBLoadCylinderControl();  (*上料气缸手动及全局变量控制*)
END_IF;
FBLoadControl();          (*上料气缸M代码控制，将该FB放出来，因为传感器检测在该FB里面，后期优化*)
FBLoadInteractiveSignal();(*上料信号交互信号输出，之前都是用Hal文件配置，复位不能清除，并且不能用配置工具配*)
IF g_nLinearActuatorFun <> 0 THEN
   FBLinearActuator();      (*上料 电动推杆 控制*)
END_IF;
IF g_bBlankCylinderEnable THEN
  FBBlankingControl();      (*前支撑气缸M代码控制*)
  FBBlankingCylinderControl();(*前支撑气缸手动及全局变量控制*)
END_IF;
FBHandlePlaneAxis();      (*板管一体龙门轴位置保持*)
(*当Y轴回零后检测避让*)
IF g_biAxIsYisHome THEN
  FBChuckAvoidance();       (*前卡卡爪避让*)
END_IF;
FBPlanProcess();          (*加工计划*)
IF g_bQREnable THEN
  FBLoadSensor();         (*全锐下料机控制*)
END_IF;
IF g_bDustEnable OR g_bIsConfigDustAxis2 THEN
  FBDustAxisControl();    (*除尘轴控制*)
END_IF;
g_boDustEnable := g_bDustEnable;(*输出给第二PLC*)
IF g_bWeldinspectionOpen OR g_nMachineType=3 THEN
FBWeldCheck();          (*焊缝检测*)
END_IF;
IF g_nMachineType = 1 OR g_nMachineType = 7 THEN
  FBBKFeedingMachineCtrl();(*标克下料机控制*)
ELSIF g_nMachineType=3 THEN
  FBKuXunLoadControl();   (*库迅管切机控制*)
  
ELSIF g_nMachineType=6 THEN(*g_nMachineType=6为3卡盘模式*)
  FBU3AxisControl();      (*迅镭三卡盘控制*)
  FBY2Y3AxisControl();
ELSIF g_nMachineType=13 THEN(*法利莱下料机*)
  FBDDAxisControl();(*轴控制模块：用于卡盘托架轴*)
  FBHGTECHAvoid();(*避让模块*)
  FBHGTECHAvoidCheck();(*检测下个轮廓是否避让*)
  FBHGTECHAvoidBlankingControl();(*上下料信号对接模块*)
  FBHGTECHPipeDiameterCheck();(*管径检测反馈及对比模块*)
END_IF;
FBAxisEnableJudge();      (*CNC及NC轴实际使能判断*)
IF g_bDustCylinderEnable OR g_bIsConfigDoubleDustChangeCyl THEN
  FBDustCylinder();       (*除尘气缸控制*)
ELSE
  g_boDustCylinderDone := TRUE;
END_IF;
FBCloseLaserControl();    (*CNC暂停状态强制关光关气*)
g_boDustCylinderEnable := g_bDustCylinderEnable;(*输出给第二PLC*)
IF g_bSustainEnable OR g_bFrontSustainEnable THEN
  FBCalSustainPos();        (*浮动支撑Z轴位置计算*)
END_IF;
FBSustainControl();       (*支撑轴浮动控制*)
FBFrontSustainControl();  (*前支撑轴浮动控制*)
IF g_nUnloadSupportClylinderNum <> 0 THEN
  FBUnloadSupportCly();
END_IF;
IF g_nMachineType = 4 OR g_nMachineType = 9 THEN
  FBDingDianManage();       (*鼎点管切控制*)
  FBDDAxisControl();      (*鼎点轴控制*)
END_IF;
FBNcAlarmHandle();        (*NC轴详细报警*)
IF g_bTurnCylinderEnable THEN
  IF g_nTurnCylControlMode = 0 THEN
    FBTurnCylinderControl();  (*翻转气缸控制*)
    FBTurnUpDown();           (*翻转气缸一键控制*)
  ELSIF g_nTurnCylControlMode = 1 THEN
    FBTurnUpDownNew();
  END_IF;
ELSE
  g_bTurnUpDownDone := TRUE;
  g_boTurnUpDownDone := TRUE;
END_IF;
FBYSpeed();
(*通用轴使用*)
IF g_bUseCommonAxis1 OR g_bUseCommonAxis2 OR g_bUseCommonAxis3 OR g_nMachineType = 19 THEN
  FBGeneralAxisControl();
  FBDDAxisControl(); 
END_IF;
(*艾泰四卡*)
IF g_nMachineType = 19 THEN
  FBU3AxisControl();
END_IF;
(*亿得*)
IF g_nMachineType = 8 OR g_nMachineType = 10 OR g_nMachineType = 9 OR g_nMachineType = 14 THEN
  FBYDControl();(*亿得下料机*)
END_IF;

FBProfileControl();       (*型材切割*)
IF g_nMachineType = 9 THEN
  FBBoendeAvoid();        (*博恩德避让检测*)
  FBBoendeAvoidCheck();   (*博恩德报警检测*)
END_IF;

IF g_nMachineType = 10 THEN
  FBBKFlatAbsAdjust();    
END_IF;
IF g_nAntiRejectionFun<>0 THEN(*左右防甩功能*)
  FBAntiRejectionControl();
END_IF;
(*3卡盘*)
IF g_nMachineType = 11 THEN
  FBY1AxisControl();
END_IF;
(*防甩轴*)
IF g_nAntiRejectionFun=2 THEN
  FBAntiRejectionManage();
END_IF;
IF g_nMachineType = 12 THEN
  FBXSControl();
END_IF;
IF g_nMachineType = 14 THEN
  FBWeiTuoManage();
END_IF;
IF g_nMachineType <> 0 THEN
  FBStartPauseResetShunt();
END_IF;
(*只有探边时才会调用*)
IF g_nEdgeCode = 1 THEN
  FBEdgeProtect();
END_IF;
HanleF050Home();
IF g_nMachineType = 21 THEN
  FBGuanLi();
END_IF;

(*新上料气缸 *)
FBSupport2();
FBCheckCutRange();
FBBracketAutoRise();


FBAvoidCylAndAxisListen();(*中卡避让和横梁避让*)
(*中卡移动避让轴*)
IF g_bIsConfigMiddleAvoidAxis1 OR g_bIsConfigMiddleAvoidAxis2 THEN
  FBMiddleAvoidAxisListen();
END_IF;
(*管材尺寸检测*)
FBPipeDimensionsCheck();
IF g_bDustEnable OR g_bDustCylinderEnable THEN
  FBDustExtractionValue();
END_IF;

(*双工位模式*)
IF g_bDualStationModeEnable THEN
  FBDualConfigMode();
END_IF;


MachinesStateRingBuffer(
     LayerStartStateIn := INT_TO_DINT(g_nLayerStart),
     LayerEndStateIn := INT_TO_DINT(g_nLayerEnd),
     nFollowStateIn := g_noFollowState_ZAxisFollow,
     nLiftStateIn := LREAL_TO_DINT(g_foTorqueState),
     nFollowErrorStateIn := INT_TO_DINT(g_nFollowStateToHmi),
     nZErrorIDIn := INT_TO_DINT(g_nZErrorIDToHmi)
     );


(*如果是普雷切割头，则将普雷调焦的使能变量赋值给外部唯一的调焦使能引脚*)
IF g_dIsPresterFocus >= 1.0 THEN
    g_boVoltageEnable :=g_boPresterFoucsEnable;
END_IF;
(*处理恩耐激光器*)
IF g_nLaserBrand=2 THEN
  g_boLaserEnable := g_boExtenIn;
END_IF;
(*安全位置信号检测*)
FBSafeSignalCheck();
IF g_bPlcPauseBuffer THEN
  g_bPlcPauseBuffer := FALSE;
  g_bPlcPause := FALSE;
END_IF;
IF  g_bPlcResetBuffer THEN
  g_bPlcReset := FALSE;
  g_bPlcResetBuffer := FALSE;
END_IF;
IF  g_bPlcStartBuffer THEN
  g_bPlcStart := FALSE;
  g_bPlcStartBuffer := FALSE;
END_IF;

IF g_bplcHardwareResetBuffer THEN(*plc伺服复位*)
  g_bplcHardwareReset :=FALSE;
  g_bplcHardwareResetBuffer := FALSE;
END_IF;

IF g_bClearAlarmButtonClickedBuffer THEN
  g_bClearAlarmButtonClickedBuffer := FALSE;
  g_bClearAlarmButtonClicked := FALSE;
END_IF;

IF NOT g_bIsSetSlowCutEnableFlag OR g_bProcessEndM THEN
		g_boSlowcutEnable := FALSE;
END_IF;


