      <variable name="nCapHeart_3">
        <type>
          <UINT/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[EDS2000上1个周期心跳值]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="nEDS3000Number">
        <type>
          <INT/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[EDS2000上1个周期心跳值]]></xhtml:p>
