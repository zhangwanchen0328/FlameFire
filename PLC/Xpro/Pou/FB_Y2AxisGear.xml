<?xml version='1.0' encoding='utf-8'?>
<pou xmlns="http://www.plcopen.org/xml/tc6_0201" xmlns:ns1="http://www.plcopen.org/xml/tc6_0201" xmlns:xhtml="http://www.w3.org/1999/xhtml" xmlns:xsd="http://www.w3.org/2001/XMLSchema" name="FB_Y2AxisGear" pouType="functionBlock">
  <interface>
    <externalVars>
      <variable name="Axis_Y2">
        <type>
          <derived name="AXIS_REF"/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[U轴轴结构体]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="g_biY2GearIn">
        <type>
          <BOOL/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[耦合开始输入引脚]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="g_biY2GearOut">
        <type>
          <BOOL/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[耦合关闭输入引脚]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="g_bY2GearIn">
        <type>
          <BOOL/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[耦合开始全局变量]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="g_bY2GearOut">
        <type>
          <BOOL/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[耦合关闭全局变量]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="g_boY2GearDone">
        <type>
          <BOOL/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[耦合完成引脚输出]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="g_bY2GearDone">
        <type>
          <BOOL/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[耦合完成全局变量]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="g_bY2GearError">
        <type>
          <BOOL/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[U轴耦合误差报警]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="g_bY2GearInError">
        <type>
          <BOOL/>
        </type>
      </variable>
      <variable name="g_bY2GearOutError">
        <type>
          <BOOL/>
        </type>
      </variable>
      <variable name="g_fCurrentCoordYBuffer">
        <type>
          <LREAL/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[CNC中Y轴坐标]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="g_Y2GearIn">
        <type>
          <derived name="MC_GEARIN"/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[耦合模块]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="g_Y2GearOut">
        <type>
          <derived name="MC_GEAROUT"/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[解耦模块]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="g_Y2MoveStop">
        <type>
          <derived name="MC_STOP"/>
        </type>
      </variable>
      <variable name="g_noY2GearErrorID">
        <type>
          <USINT/>
        </type>
      </variable>
      <variable name="g_nNumerator">
        <type>
          <INT/>
        </type>
      </variable>
      <variable name="g_nDenominator">
        <type>
          <USINT/>
        </type>
      </variable>
    </externalVars>
    <localVars>
      <variable name="nGearState">
        <type>
          <INT/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[状态机]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="nRatioNumerator">
        <type>
          <INT/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[比例分子]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="nRatioDenominator">
        <type>
          <USINT/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[比例分母]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="dCoordDiff">
        <type>
          <LREAL/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[耦合成功时U和U2的坐标差]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="dCoordMaxDiff">
        <type>
          <LREAL/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[U和U2最大的的坐标差]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="bGearIn">
        <type>
          <BOOL/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[耦合开始]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="bGearOut">
        <type>
          <BOOL/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[耦合关闭]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="bGearDone">
        <type>
          <BOOL/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[耦合完成]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="bGearCheck">
        <type>
          <BOOL/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[是否检测耦合误差]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="RTrigger1">
        <type>
          <derived name="R_TRIG"/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[上升沿函数]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="RTrigger2">
        <type>
          <derived name="R_TRIG"/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[下降沿函数]]></xhtml:p>
        </documentation>
      </variable>
    </localVars>
  </interface>
  <body>
    <ST>
      <xhtml:p><![CDATA[
RTrigger1(CLK := g_biY2GearIn OR g_bY2GearIn OR bGearIn OR g_bY2GearInM);
RTrigger2(CLK := g_biY2GearOut OR g_bY2GearOut OR bGearOut OR g_bY2GearOutM);

IF RTrigger1.Q THEN
  IF Axis_Y2.NCTOPLC.AxisState <> 8 THEN
    nGearState := 1;
    g_boY2GearDone := FALSE;
    g_bY2GearDone := FALSE;
    bGearDone := FALSE;
  ELSE  
    M.ENABLE[186] := 0;
  END_IF;
  g_bY2GearInM := FALSE;
END_IF;

IF RTrigger2.Q THEN
  IF Axis_Y2.NCTOPLC.AxisState = 8 THEN
    nGearState := 2;
    g_boY2GearDone := FALSE;
    g_bY2GearDone := FALSE; 
    bGearDone := FALSE;
  ELSE  
    M.ENABLE[186] := 0;
  END_IF;
  g_bY2GearOutM := FALSE;
END_IF;

CASE nGearState OF
  0:
    nGearState := 0;
  1:
    g_Y2GearIn.Execute := TRUE;
    g_Y2GearIn.RatioNumerator := INT_TO_LREAL(g_nNumerator);
    g_Y2GearIn.RatioDenominator := g_nDenominator;
    IF g_Y2GearIn.InGear THEN
      g_boY2GearDone := TRUE;
      g_bY2GearDone := TRUE;
      M.ENABLE[186] := 0;
      bGearDone := TRUE;
      nGearState := 30;
      bGearCheck := TRUE;
      dCoordDiff := ABS(g_fCurrentCoordYBuffer - Axis_Y2.NCTOPLC.ACTPOS);
    END_IF;
    IF g_Y2GearIn.Error OR g_Y2GearIn.CommandAborted THEN
      g_Y2GearIn.Execute := FALSE;
      g_noY2GearErrorID := g_Y2GearIn.ErrorID;
      g_bY2GearInError := TRUE;
      nGearState := 0;
    END_IF;
  2:
    g_Y2GearOut.Execute := TRUE;
    g_Y2GearIn.Execute := FALSE;
    IF g_Y2GearOut.Done THEN
      g_Y2GearOut.Execute := FALSE;
      IF Axis_Y2.NCTOPLC.AxisState = 2 THEN
        nGearState := 0;
        M.ENABLE[186] := 0;
      ELSE
        nGearState := 3;
      END_IF;
    END_IF;
    IF g_Y2GearOut.Error THEN
      g_Y2GearOut.Execute := FALSE;
      g_bY2GearInError := TRUE;
      nGearState := 0;
      bGearCheck := FALSE;
    END_IF;
  3:
    g_Y2MoveStop.Execute := TRUE;
    IF g_Y2MoveStop.Done THEN
      g_Y2MoveStop.Execute := FALSE;
      nGearState := 0;
      M.ENABLE[186] := 0;
    END_IF;
    IF g_Y2MoveStop.Commandaborted OR g_Y2MoveStop.Error THEN
      g_Y2MoveStop.Execute := FALSE;
      nGearState := 0;
    END_IF;
END_CASE;

IF Axis_Y2.NCTOPLC.AxisState = 8 THEN
  IF ABS(ABS(g_fCurrentCoordYBuffer - Axis_Y2.NCTOPLC.ACTPOS) - dCoordDiff) > dCoordMaxDiff AND Axis_Y2.NCTOPLC.AXISSTATE = 8 THEN
      g_bY2GearError := TRUE;
  END_IF;
END_IF;
]]></xhtml:p>
    </ST>
  </body>
</pou>
