<?xml version='1.0' encoding='utf-8'?>
<pou xmlns="http://www.plcopen.org/xml/tc6_0201" xmlns:ns1="http://www.plcopen.org/xml/tc6_0201" xmlns:xhtml="http://www.w3.org/1999/xhtml" xmlns:xsd="http://www.w3.org/2001/XMLSchema" name="FB_Y2Y3AxisControl" pouType="functionBlock">
  <interface>
    <localVars>
      <variable name="FBY2Y3AxisAbs">
        <type>
          <derived name="FB_Y2Y3AxisAbs"/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[绝对运动]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="FBY2Y3AxisActMotion">
        <type>
          <derived name="FB_Y2Y3ActMove_Motion"/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[运动模块]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="FBY2Y3AxisHome">
        <type>
          <derived name="FB_Y2Y3AxisHome"/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[回零]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="FBY2Y3AxisJog">
        <type>
          <derived name="FB_Y2Y3AxisJog"/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[点动]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="FBY2Y3AxisRel">
        <type>
          <derived name="FB_Y2Y3AxisRel"/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[相对运动]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="FBY2Y3AxisPower">
        <type>
          <derived name="FB_Y2Y3AxisPower"/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[使能]]></xhtml:p>
        </documentation>
      </variable>
    </localVars>
    <externalVars>
      <variable name="g_bPlcResetBuffer">
        <type>
          <BOOL/>
        </type>
      </variable>
      <variable name="g_Y3Reset">
        <type>
          <derived name="MC_RESET"/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[复位]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="g_Y2Reset">
        <type>
          <derived name="MC_RESET"/>
        </type>
        <documentation>
          <xhtml:p><![CDATA[复位]]></xhtml:p>
        </documentation>
      </variable>
      <variable name="Axis_Y2">
        <type>
          <derived name="AXIS_REF"/>
        </type>
      </variable>
      <variable name="Axis_Y3">
        <type>
          <derived name="AXIS_REF"/>
        </type>
      </variable>
    </externalVars>
    <localVars>
      <variable name="FBY2Y3Avoid">
        <type>
          <derived name="FB_Y2Y3Avoid"/>
        </type>
      </variable>
      <variable name="FBY2Gear">
        <type>
          <derived name="FB_Y2AxisGear"/>
        </type>
      </variable>
      <variable name="FBY3Gear">
        <type>
          <derived name="FB_Y3AxisGear"/>
        </type>
      </variable>
      <variable name="FBClaw3Avoid">
        <type>
          <derived name="FB_Claw3Avoid"/>
        </type>
      </variable>
      <variable name="FBClaw3OneKeyMove">
        <type>
          <derived name="FB_Claw3OneKeyMove"/>
        </type>
      </variable>
      <variable name="FBClaw3ClyAvoid">
        <type>
          <derived name="FB_CLaw3ClyAvoid"/>
        </type>
      </variable>
    </localVars>
  </interface>
  <body>
    <ST>
      <xhtml:p><![CDATA[FBY2Y3AxisAbs();
FBY2Y3AxisActMotion();
FBY2Y3AxisHome();
FBY2Y3AxisJog();
FBY2Y3AxisRel();
FBY2Y3AxisPower();
FBY2Gear();
FBClaw3Avoid();
FBY2Y3Avoid();
FBClaw3OneKeyMove();
FBClaw3ClyAvoid();
FBY3Gear();
IF Axis_Y2.NCTOPLC.AxisState = 8 THEN
  g_Y2Reset.Execute := FALSE;
ELSE
  IF Axis_Y2.NCTOPLC.ERRORCODE <>0 AND g_bPlcResetBuffer THEN
    g_Y2Reset.Execute := TRUE;
  ELSE
    g_Y2Reset.Execute := FALSE;   
  END_IF;
END_IF;

IF Axis_Y3.NCTOPLC.AxisState = 8 THEN
  g_Y3Reset.Execute := FALSE;
ELSE
  IF Axis_Y3.NCTOPLC.ERRORCODE <>0 AND g_bPlcResetBuffer THEN
    g_Y3Reset.Execute := TRUE;
  ELSE
    g_Y3Reset.Execute := FALSE;   
  END_IF;
END_IF;]]></xhtml:p>
    </ST>
  </body>
  <documentation>
    <xhtml:p><![CDATA[Y2Y3轴运动控制模块]]></xhtml:p>
  </documentation>
</pou>
